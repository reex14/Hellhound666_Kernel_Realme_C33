[
    {
        "kernelSource": {
            "name": "realme_c35_nyx",
            "repo": "https://github.com/rifsxd/nyx_android_kernel_realme_c35",
            "branch": "dev",
            "device": "realme_c35",
            "defconfig": "realme_c35_nyx_defconfig"
        },
        "toolchains": [
            {
                "repo": "https://github.com/maxsteeel/proton-12",
                "branch": "main",
                "name": "clang",
                "binaryEnv": [
                    "bin"
                ]
            }
        ],
        "enableCcache": true,
        "params": {
            "ARCH": "arm64",
            "CC": "clang",
            "externalCommands": {
                "CROSS_COMPILE": "aarch64-linux-gnu-",
                "CROSS_COMPILE_ARM32": "arm-linux-gnueabi-",
                "LD": "ld.lld",
                "AR": "llvm-ar",
                "NM": "llvm-nm",
                "OBJCOPY": "llvm-objcopy",
                "OBJDUMP": "llvm-objdump",
                "READELF": "llvm-readelf",
                "OBJSIZE": "llvm-size",
                "STRIP": "llvm-strip",
                "LDGOLD": "aarch64-linux-gnu-ld.gold",
                "LLVM_AR": "llvm-ar",
                "LLVM_DIS": "llvm-dis",
                "BSP_BUILD_ANDROID_OS": "y",
                "BSP_BUILD_FAMILY": "qogirl6"
            }
        },
        "AnyKernel3": {
            "use": true,
            "release": true,
            "custom": {
                "repo": "https://github.com/rifsxd/AnyKernel3",
                "branch": "master"
            }
        },
        "KernelSU": {
            "enable": false,
            "custom": {
                "user": "rifsxd",
                "branch": "next",
                "repo": "KernelSU-Next"
            }
        }
    }
]